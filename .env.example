# SAT AKADEMIYASI — kerakli environment o'zgaruvchilari
# Bu faylni .env.local nomi bilan nusxalang va haqiqiy qiymatlar bilan to'ldiring.
# .env.local hech qachon git'ga qo'shilmasin.

# --- Supabase (ma'lumotlar bazasi) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessiya xavfsizligi ---
SESSION_SECRET=

# --- Admin panel ruxsati ---
ADMIN_PHONE=
ADMIN_EMAIL=

# --- Google orqali kirish ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=

# --- Yashirin admin manzili ---
ADMIN_PATH=
ADMIN_ACCESS_CODE=

# --- Click to'lov tizimi ---
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# --- Payme to'lov tizimi ---
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Telegram yordam kanali
NEXT_PUBLIC_HELP_URL=https://t.me/your_channel
