# SAT AKADEMIYASI — kerakli environment o'zgaruvchilari
# Bu faylni .env.local nomi bilan nusxalang va haqiqiy qiymatlar bilan to'ldiring.
# .env.local hech qachon git'ga qo'shilmasin.

# --- Supabase (ma'lumotlar bazasi) ---
# 1. https://supabase.com da bepul loyiha yarating
# 2. Project Settings -> API -> "Project URL" va "service_role" kalitini oling
# 3. supabase/schema.sql faylini Supabase SQL Editor'da ishga tushiring
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessiya xavfsizligi ---
# Terminalda `openssl rand -hex 32` bilan tasodifiy qator generatsiya qiling.
# Production'da MAJBURIY (kamida 16 belgi) — busiz login ishlamaydi.
SESSION_SECRET=

# --- Admin panel ruxsati ---
# /api/admin/* endpoint'lariga faqat shu telefon raqamli akkaunt kira oladi
# (users.phone bilan solishtiriladi). Production'da bu MAJBURIY — bo'sh
# qoldirilsa /api/admin/* butunlay ishlamay qoladi (himoyasiz ochiq qolishning
# oldini olish uchun). Local development'da bo'sh qoldirsangiz, har qanday
# tizimga kirgan foydalanuvchi admin panelga kira oladi (faqat local test uchun qulay).
ADMIN_PHONE=
# (ixtiyoriy) Egasi Google orqali kirsa: Google akkauntingiz emaili. Faqat Google
# bilan tasdiqlangan email egasi sifatida tan olinadi.
ADMIN_EMAIL=

# --- Google orqali kirish (v50) ---
# https://console.cloud.google.com → APIs & Services → Credentials → Create
# credentials → OAuth client ID → "Web application".
#   Authorized redirect URI:  https://SAYT.uz/api/auth/google/callback
#   (local: http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Saytning to'liq manzili (Google redirect uchun), masalan https://sayt.uz
APP_URL=

# --- Yashirin admin manzili (v38) ---
# /admin manzili endi 404 beradi. Admin panel shu yashirin manzilda ochiladi:
#   ADMIN_PATH=boshqaruv-7k2p   →   https://sayt.uz/boshqaruv-7k2p
# Faqat harf, raqam va "-" ishlating; hech kimga aytmang. Xohlagan paytda
# o'zgartirishingiz mumkin (keyin serverni qayta ishga tushiring).
ADMIN_PATH=

# Admin panelga HAR SAFAR kirishda so'raladigan kod. U eskirmaydi — siz shu
# yerda o'zgartirmaguningizcha bir xil qoladi. Kamida 10 belgi. Production'da MAJBURIY.
# O'zgartirish: shu qiymatni yangilang → serverni qayta ishga tushiring
# (Vercel'da: Settings → Environment Variables → Redeploy).
ADMIN_ACCESS_CODE=

# --- Click to'lov tizimi (https://docs.click.uz) ---
# Merchant hisobingiz tayyor bo'lgach to'ldiring
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# --- Payme to'lov tizimi (https://developer.help.paycom.uz) ---
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# Telegram channel / bot / contact shown in "Yordam markazi" and "Kursga qo'shilish" (dashboard)
NEXT_PUBLIC_HELP_URL=https://t.me/your_channel

# Telegram bot <-> site: shared secret for course codes (same value in the bot: COURSE_CODE_SECRET). Use a long random string.
COURSE_CODE_SECRET=change-me-long-random

# Parolni email kod orqali tiklash (https://resend.com — bepul). Domen tasdiqlangach MAIL_FROM ni o'zgartiring.
RESEND_API_KEY=
MAIL_FROM="SAT Akademiyasi <onboarding@resend.dev>"
